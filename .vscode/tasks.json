{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ensure Postgres",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Ensure LiveKit",
      "type": "shell",
      "command": "docker compose up -d livekit",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Ensure Backend Services",
      "dependsOn": ["Ensure Postgres", "Ensure LiveKit"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Wait for Backend Ready",
      "type": "shell",
      "command": "Write-Host 'Waiting for backend on http://127.0.0.1:3000/health (up to 180s)...'; $ready = $false; for ($i = 0; $i -lt 360; $i++) { Start-Sleep -Milliseconds 500; try { $r = Invoke-WebRequest -Uri http://127.0.0.1:3000/health -UseBasicParsing -TimeoutSec 2 -ErrorAction Stop; if ($r.StatusCode -eq 200) { $ready = $true; break } } catch {} }; if ($ready) { Write-Host 'Backend is ready.' } else { Write-Host 'ERROR: Backend did not become ready within 180s'; exit 1 }",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      // Full docker stack for the GUI e2e suite (postgres + redis + livekit
      // + wavis-backend), rebuilt with test-no-rate-limits (see security.md)
      // so a full suite run can't trip JoinRateLimiter/TempBanList/etc — the
      // suite's own auth traffic still needs AUTH_REGISTER_RATE_LIMIT /
      // AUTH_RECOVER_RATE_LIMIT raised since those aren't covered by that
      // feature (see e2e-tooling/README.md). Always rebuilds (--build) so the
      // running container matches these env vars and any local backend code
      // changes; paired with "Restore Normal Backend" as this launch
      // config's postDebugTask so the dev backend isn't left rate-limit-free.
      "label": "Ensure E2E Backend Stack",
      "type": "shell",
      "command": "docker compose up -d --build",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "AUTH_REGISTER_RATE_LIMIT": "200",
          "AUTH_RECOVER_RATE_LIMIT": "200",
          "CARGO_FEATURES": "test-no-rate-limits"
        }
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "E2E Stack Ready",
      "dependsOn": ["Ensure E2E Backend Stack", "Wait for Backend Ready"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      // Rebuilds wavis-backend without test-no-rate-limits (CARGO_FEATURES
      // unset → defaults to empty in docker-compose.yml) so the shared local
      // dev backend isn't left running rate-limit-free after an e2e run.
      // Runs as "Test: GUI E2E (Playwright)"'s postDebugTask.
      "label": "Restore Normal Backend",
      "type": "shell",
      "command": "docker compose up -d --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },

    // ─── Test Tasks (multi-binary, can't use LLDB launch) ─────
    {
      "label": "Integration Tests Backend (all)",
      "type": "shell",
      "command": "cargo test --package=wavis-backend --tests --features=test-metrics",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "RUST_LOG": "debug,wavis_backend=trace",
          "RUST_BACKTRACE": "full"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Integration Tests Client Shared (all)",
      "type": "shell",
      "command": "cargo test --package=wavis-client-shared --tests",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "RUST_LOG": "debug,wavis_client_shared=trace",
          "RUST_BACKTRACE": "full"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Test Entire Workspace",
      "type": "shell",
      "command": "cargo test --workspace --features=test-metrics",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "RUST_LOG": "info",
          "RUST_BACKTRACE": "1"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$rustc"
    },

    // ─── Quality Gates (mirror workspace-ci.yml blocking steps) ───
    {
      "label": "Gate: Rustfmt Check",
      "type": "shell",
      "command": "cargo fmt --all --check",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Gate: Arch Check",
      "type": "shell",
      "command": "node scripts/arch-check.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: Clippy (blocking)",
      "type": "shell",
      "command": "cargo clippy -p shared -p wavis-backend -p wavis-client-shared -p wavis-cli-test -p wavis-client -p ws-sfu-test -p stress-harness -p gui-surface-test -- -D warnings",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Gate: GUI Prettier Check",
      "type": "shell",
      "command": "npm run format:check",
      "options": { "cwd": "${workspaceFolder}/clients/wavis-gui" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: GUI ESLint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}/clients/wavis-gui" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$eslint-stylish"
    },
    {
      "label": "Gate: GUI Dependency Cruiser",
      "type": "shell",
      "command": "npm run lint:deps",
      "options": { "cwd": "${workspaceFolder}/clients/wavis-gui" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: GUI Typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "options": { "cwd": "${workspaceFolder}/clients/wavis-gui" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "Gate: GUI Tests (vitest)",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/clients/wavis-gui" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      // Everything CI blocks on, in the same cheap-first order, failing
      // fast at the first red gate. Warnings (ESLint warn rules, clippy
      // metrics) never fail this — errors only, matching workspace-ci.yml.
      "label": "Full CI Check",
      "type": "shell",
      "command": "cargo fmt --all --check; if (!$?) { exit 1 }; node scripts/arch-check.mjs; if (!$?) { exit 1 }; npm --prefix clients/wavis-gui run format:check; if (!$?) { exit 1 }; npm --prefix clients/wavis-gui run lint; if (!$?) { exit 1 }; npm --prefix clients/wavis-gui run lint:deps; if (!$?) { exit 1 }; npm --prefix clients/wavis-gui run typecheck; if (!$?) { exit 1 }; cargo clippy -p shared -p wavis-backend -p wavis-client-shared -p wavis-cli-test -p wavis-client -p ws-sfu-test -p stress-harness -p gui-surface-test -- -D warnings; if (!$?) { exit 1 }; cargo test; if (!$?) { exit 1 }; npm --prefix clients/wavis-gui test; if (!$?) { exit 1 }; Write-Host 'ALL GATES GREEN'",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },

    // ─── Python / Terraform Tests ─────────────────────────────
    {
      "label": "Pytest: Validate Plan",
      "type": "shell",
      "command": "python -m pytest tests/validate_plan.py -v --plan-json plan.json",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Pytest: Workflow Validation",
      "type": "shell",
      "command": "python -m pytest tests/test_workflow.py -v",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Pytest: Health Integration",
      "type": "shell",
      "command": "python -m pytest tests/test_health_integration.py -v",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BACKEND_URL": "http://localhost:3000"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Pytest: All Terraform Tests",
      "type": "shell",
      "command": "python -m pytest tests/ -v --plan-json plan.json",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
