    // ─── Integration Tests ──────────────────────────────────────
    // NOTE: "Integration Tests Backend (all)" and
    //       "Integration Tests Client Shared (all)" are Tasks, not launch
    //       configs, because --tests produces one binary per test file and
    //       LLDB needs exactly one. Use: Terminal > Run Task > ...
    {
      "type": "lldb",
      "request": "launch",
      "name": "Integration Test Backend (single file)",
      "cargo": {
        "args": ["test", "--package=wavis-backend", "--test", "${input:integrationTestFile}", "--features=test-metrics", "--no-run"]
