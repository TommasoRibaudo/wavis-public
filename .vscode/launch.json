      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "6_python-terraform", "order": 2 }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Pytest: All Terraform Tests",
      "module": "pytest",
      "args": ["tests/", "-v", "--plan-json", "${input:planJsonPath}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "presentation": { "group": "6_python-terraform", "order": 3 }
    },

    // ─── GUI (Tauri) ────────────────────────────────────────────
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Run Wavis GUI (Tauri Dev)",
      "command": "npx tauri dev",
      "cwd": "${workspaceFolder}/clients/wavis-gui",
      "env": {
        "RUST_BACKTRACE": "1"
      },
      "presentation": { "group": "7_gui-tauri", "order": 0 }
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Test: GUI E2E (Playwright)",
      // Brings the docker stack up — rebuilt with test-no-rate-limits and
      // raised auth register/recover limits (see "Ensure E2E Backend Stack"
      // in tasks.json) — and waits for /health before running. postDebugTask
      // rebuilds the backend back to normal afterward either way, so the
      // shared local dev backend never stays rate-limit-free.
      "preLaunchTask": "E2E Stack Ready",
      "postDebugTask": "Restore Normal Backend",
      "command": "npm run test",
      "cwd": "${workspaceFolder}/clients/wavis-gui/e2e-tooling",
      "presentation": { "group": "7_gui-tauri", "order": 1 }
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Build GUI Debug Exe (for E2E tests)",
      "command": "npx tauri build --debug",
      "cwd": "${workspaceFolder}/clients/wavis-gui",
      // Both vars are REQUIRED for e2e (see e2e-tooling/README.md). Without
      // them the exe reads the developer's real wavis-auth.json and the
      // live-backend specs drive the real session (log it out, hang on the
      // missing insecure-TLS toggle). Never build the e2e exe without these.
      "env": {
        "VITE_ALLOW_INSECURE_TLS": "true",
        "VITE_AUTH_STORE_NAME": "wavis-auth-e2e.json"
      },
      "presentation": { "group": "7_gui-tauri", "order": 2 }
    },

    // ─── CI Checks ─────────────────────────────────────────────
    // Reuses the canonical "Full CI Check" task so Run & Debug keeps its
    // fail-fast, cheap-first ordering and Problems-panel matchers. Individual
    // gates (Rustfmt, Clippy, Arch Check, Prettier, ESLint, deps, typecheck,
    // vitest) are available via Terminal > Run Task for ad-hoc use.
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "CI: Full CI Check",
      "preLaunchTask": "Full CI Check",
      "command": "Write-Host 'Full CI Check passed'",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "8_ci", "order": 0 }
    }

    // ─── Workspace-Wide ─────────────────────────────────────────
    // NOTE: "Test Entire Workspace" is a Task, not a launch config,
    //       because --workspace produces binaries for every crate.
    //       Use: Terminal > Run Task > Test Entire Workspace
  ],

  // ─── Compound Launch Configurations ─────────────────────────
  "compounds": [
    {
      "name": "Backend + CLI Client (P2P)",
      "configurations": ["Run Backend", "Run CLI Test Client (server)"],
      "stopAll": true,
      "presentation": { "group": "9_compound", "order": 0 }
    },
    {
      "name": "Backend + CLI Client (SFU)",
      "configurations": ["Run Backend", "Run CLI Test Client (SFU)"],
      "stopAll": true,
      "presentation": { "group": "9_compound", "order": 1 }
    },
    {
      "name": "Backend + Full CLI Client",
      "configurations": ["Run Backend", "Run CLI Client"],
      "stopAll": true,
      "presentation": { "group": "9_compound", "order": 2 }
    },
    {
      "name": "Backend + Stress (single scenario)",
      "configurations": ["Run Backend", "Stress Harness (single scenario, in-process)"],
      "stopAll": true,
      "presentation": { "group": "9_compound", "order": 3 }
    },
    {
      "name": "Backend + GUI Surface Test",
      "configurations": ["Run Backend", "GUI Surface Test"],
      "stopAll": true,
      "presentation": { "group": "9_compound", "order": 4 }
    },
    {
      "name": "Backend + Stress (external, custom URL)",
      "configurations": ["Run Backend", "Stress Harness (external backend)"],
      "stopAll": true,
      "presentation": { "group": "9_compound", "order": 5 }
    },
    {
      "name": "Backend + Wavis GUI",
      "configurations": ["Run Backend", "Run Wavis GUI (Tauri Dev)"],
      "stopAll": true,
      "presentation": { "group": "9_compound", "order": 6 }
    }
  ],

  "inputs": [
    {
      "id": "testName",
      "description": "Test function name (or substring to filter)",
      "type": "promptString",
      "default": ""
    },
    {
      "id": "integrationTestFile",
      "description": "Integration test file name for wavis-backend (without .rs)",
      "type": "promptString",
      "default": "signaling_relay_integration"
    },
    {
      "id": "clientSharedIntegrationTestFile",
      "description": "Integration test file name for wavis-client-shared (without .rs)",
      "type": "promptString",
      "default": "full_call_flow_integration"
    },
    {
      "id": "stressScenario",
      "description": "Stress scenario name (e.g. join_flood, brute_force_invite, slowloris)",
      "type": "promptString",
      "default": "join_flood"
    },
    {
      "id": "wsUrl",
      "description": "WebSocket URL for external backend",
      "type": "promptString",
      "default": "ws://127.0.0.1:3000/ws"
    },
    {
      "id": "roomId",
      "description": "Room ID to join",
      "type": "promptString",
      "default": "test-room"
    },
    {
      "id": "inviteCode",
      "description": "Invite code (leave empty to create a new room)",
      "type": "promptString",
      "default": ""
    },
    {
      "id": "metricsUrl",
      "description": "Metrics endpoint URL for external backend",
      "type": "promptString",
      "default": "http://127.0.0.1:3001/test/metrics"
    },
    {
      "id": "planJsonPath",
      "description": "Path to terraform show -json plan.out output file",
      "type": "promptString",
      "default": "plan.json"
    }
  ]
}
