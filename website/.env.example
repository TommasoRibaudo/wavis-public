# Mailing list — Google Form backing a Google Sheet.
#
# Setup:
#   1. Create a Google Form with a single short-answer question for the email.
#   2. Link the form to a Google Sheet (Responses → Link to Sheets).
#   3. Open the form's prefilled-link tool (⋮ → Get pre-filled link), submit a
#      sample, and copy the resulting URL. The action endpoint is the form URL
#      with /viewform replaced by /formResponse, and the email field id is the
#      entry.NNNNNNNNN parameter.
#
# Example endpoint: https://docs.google.com/forms/d/e/1FAIpQLSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/formResponse
# Example field id: entry.1234567890
NEXT_PUBLIC_SUBSCRIBE_FORM_ACTION=
NEXT_PUBLIC_SUBSCRIBE_ENTRY_ID=

# Canonical site URL (used for metadata, sitemap, robots). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://wavis.app
